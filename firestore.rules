rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Vendor Validation
    function isValidVendor(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.email is string && data.email.size() <= 100
          && (data.password == null || (data.password is string && data.password.size() >= 4 && data.password.size() <= 20))
          && (data.phone == null || data.phone is string)
          && (data.fax == null || data.fax is string)
          && (data.representative == null || data.representative is string)
          && (data.businessNumber == null || data.businessNumber is string)
          && (data.notes == null || data.notes is string)
          && (data.priceTableUrl == null || data.priceTableUrl is string)
          && (data.priceTableFileType == null || data.priceTableFileType is string)
          && (data.priceTableFileName == null || data.priceTableFileName is string)
          && (data.useRounding == null || data.useRounding is bool)
          && (data.masterCustomFlag == null || data.masterCustomFlag is bool)
          && (data.handlingDetails == null || data.handlingDetails is map);
    }

    match /vendors/{vendorId} {
      allow read, write: if true;

      match /prices/{priceId} {
        allow read, write: if true;
      }

      match /handling_items/{itemId} {
        allow read, write: if true;
      }
    }
  }
}
