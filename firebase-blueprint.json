{
  "firestore": {
    "vendors": {
      "path": "vendors",
      "description": "Master list of vendors/suppliers",
      "subcollections": {
        "prices": {
          "schema": "PriceItem",
          "description": "Individual unit prices for products from this vendor"
        },
        "handling_items": {
          "schema": "ComparisonRow",
          "description": "Individual comparison items for this vendor"
        }
      }
    },
    "pending_updates": {
      "path": "pending_updates",
      "schema": "PendingPriceUpdate",
      "description": "Approval queue for price changes requested by vendors"
    },
    "settings": {
      "path": "settings",
      "schema": "AdminSettings",
      "description": "System settings including admin password"
    }
  },
  "entities": {
    "AdminSettings": {
      "title": "Admin Settings",
      "description": "Sensitive system configuration",
      "type": "object",
      "properties": {
        "password": { "type": "string" }
      },
      "required": ["password"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "A supplier or manufacturing company",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "representative": { "type": "string" },
        "businessNumber": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string" },
        "phone": { "type": "string" },
        "fax": { "type": "string" },
        "notes": { "type": "string" },
        "roundingMethod": { "type": "string" },
        "notice": { "type": "string" },
        "noticeFileUrl": { "type": "string" },
        "noticeFileType": { "type": "string" },
        "noticeFileName": { "type": "string" },
        "noticeUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "PriceItem": {
      "title": "Price Item",
      "description": "A specific product's unit price information",
      "type": "object",
      "properties": {
        "itemName": { "type": "string" },
        "spec": { "type": "string" },
        "unit": { "type": "string" },
        "costPrice": { "type": "number" },
        "negoRate": { "type": "number" },
        "unitPrice": { "type": "number" },
        "remarks": { "type": "string" },
        "maker": { "type": "string" },
        "order": { "type": "number" },
        "useRounding": { "type": "boolean", "description": "Whether to apply rounding to this specific item" }
      },
      "required": ["itemName", "costPrice", "unitPrice"]
    },
    "ComparisonRow": {
      "title": "Comparison Row",
      "description": "A category row in the comparison matrix",
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "vendor1": { "type": "string" },
        "vendor2": { "type": "string" },
        "vendor3": { "type": "string" },
        "vendor4": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["category"]
    },
    "PendingPriceUpdate": {
      "title": "Pending Price Update",
      "description": "A request to change price data that requires approval",
      "type": "object",
      "properties": {
        "vendorId": { "type": "string" },
        "priceItemId": { "type": "string" },
        "itemName": { "type": "string" },
        "spec": { "type": "string" },
        "oldData": { "type": "object" },
        "newData": { "type": "object" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "requestedBy": { "type": "string" },
        "requestedAt": { "type": "string", "format": "date-time" },
        "approvedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vendorId", "priceItemId", "status", "requestedAt"]
    }
  }
}
