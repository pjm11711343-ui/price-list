{
  "firestore": {
    "vendors": {
      "path": "vendors",
      "description": "Master list of vendors/suppliers",
      "subcollections": {
        "handling_items": {
          "schema": "ComparisonRow",
          "description": "Individual comparison items for this vendor"
        }
      }
    }
  },
  "entities": {
    "Vendor": {
      "title": "Vendor",
      "description": "A supplier or manufacturing company",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "representative": { "type": "string" },
        "businessNumber": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string" },
        "handlingDetails": { "type": "object", "description": "Legacy field, migrated to subcollection" }
      },
      "required": ["name", "email"]
    },
    "ComparisonRow": {
      "title": "Comparison Row",
      "description": "A category row in the comparison matrix",
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "vendor1": { "type": "string" },
        "vendor2": { "type": "string" },
        "vendor3": { "type": "string" },
        "vendor4": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["category"]
    }
  }
}
