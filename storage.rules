rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /price_tables/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    match /notices/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    match /vendor_docs/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    match /contracts/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
